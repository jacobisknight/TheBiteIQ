{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "biteiq.tech"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "biteiq.tech"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DOMAIN": "biteiq.tech"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appName": "BiteIQ",
        "language": "en-US",
        "sku": "biteiq-ios-001",
        "bundleIdentifier": "tech.biteiq.app"
      }
    }
  }
}
